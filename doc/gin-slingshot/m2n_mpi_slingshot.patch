+
+MARK_DIR="${M2N_MARK_DIR:?}"; BUDGET="${M2N_BUDGET:-1500}"; mkdir -p "$MARK_DIR"; FAILS=0
+guarded() { # key fn args...
+  local key fn; key="$(echo "${NCCL_M2N_MPI_TEST_PROFILE}:$1:${NCCL_COMM_BLOCKING:-}:${NCCL_RESHARD_STAGING_CHANNEL_SIZE:-}:${GTEST_SHARD_INDEX:-}" | tr -c 'A-Za-z0-9:_.-' '_')"; fn="$2"; shift 2
+  [[ -f "$MARK_DIR/$key.ok" ]] && { echo "[skip-done] $key"; return 0; }
+  if (( SECONDS > BUDGET )); then echo "[budget] deferring $key"; return 0; fi
+  if "$fn" "$@"; then touch "$MARK_DIR/$key.ok"; echo "[CASE-OK] $key"; else echo "[CASE-FAIL] $key"; touch "$MARK_DIR/$key.fail"; FAILS=$((FAILS+1)); fi
+  return 0
+}
+runCase() {
+  if [[ "$1" == "all algorithms, source parity" ]]; then
+    local k; for k in 0 1 2 3; do GTEST_TOTAL_SHARDS=4 GTEST_SHARD_INDEX=$k guarded "$1 shard $k" runCase_orig "$@"; done
+  else guarded "$*" runCase_orig "$@"; fi
+}
+runPackSplitCase() { guarded "$*" runPackSplitCase_orig "$@"; }
+runPackGroupCase() { guarded "pack-group" runPackGroupCase_orig "$@"; }
+runEightRankDefaultMatrix() { guarded "eight-default-matrix" runEightRankDefaultMatrix_orig "$@"; }
+runBenchmark() { guarded "$*" runBenchmark_orig "$@"; }
